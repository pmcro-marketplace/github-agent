{
  "agentId": "github-agent",
  "repositoryScope": "pmcro-marketplace",
  "phaseOrder": ["orchestrate", "plan", "make", "check", "reflect"],
  "capabilities": {
    "/github:repository-discovery:get-repository": {"method": "GET", "binding": "GITHUB_REST"},
    "/github:actions:inspect": {"method": "GET", "binding": "GITHUB_REST"},
    "/github:actions:verify-run": {"method": "GET", "binding": "GITHUB_REST"},
    "/github:actions:dispatch": {"binding": "UNBOUND"},
    "/github:change-management:create-repository": {"binding": "UNBOUND"}
  }
}
